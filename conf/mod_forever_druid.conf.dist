[worldserver]

########################################
# mod-forever-druid
#
# WoW Forever-style bear tanking: Swipe (Bear) costs no rage, Bear Form and Dire Bear Form give
# rage every time you dodge, Frenzied Regeneration turns rage into more health, and druids learn
# Cataclysm's Pulverize. Consumables work in Cat Form and Bear Form, and Cat Form combo points
# carry over to the next target like a rogue's.
########################################

#
#    ForeverDruid.Swipe.Enable
#        Description: Change the rage cost of every rank of Swipe (Bear). With 0, Swipe costs
#                     the game data's 20 rage again.
#        Default:     1
#

ForeverDruid.Swipe.Enable = 1

#
#    ForeverDruid.Swipe.RageCost
#        Description: Swipe (Bear)'s rage cost when ForeverDruid.Swipe.Enable = 1. The Ferocity
#                     talent still takes its 1-5 rage off, down to 0. Without the optional client
#                     patch the client still expects 20 rage and won't let you press Swipe with
#                     less; with it, the patch must use the same value (see
#                     tools/patch-forever-druid-dbc.sh).
#        Default:     0
#

ForeverDruid.Swipe.RageCost = 0

#
#    ForeverDruid.Swipe.LearnWithBearForm
#        Description: Druids learn Swipe (Bear) rank 1 together with Bear Form (level 10) instead
#                     of training it at 16. Druids who already know Bear Form get it at their next
#                     login. Turning it off doesn't take Swipe away.
#        Default:     1
#

ForeverDruid.Swipe.LearnWithBearForm = 1

#
#    ForeverDruid.BearDodgeRage.Enable
#        Description: Give rage every time a druid in Bear Form or Dire Bear Form dodges an
#                     attack. Stacks with the Natural Reaction talent.
#        Default:     1
#

ForeverDruid.BearDodgeRage.Enable = 1

#
#    ForeverDruid.BearDodgeRage.Amount
#        Description: Rage gained per dodge.
#        Default:     5
#

ForeverDruid.BearDodgeRage.Amount = 5

#
#    ForeverDruid.FrenziedRegeneration.Enable
#        Description: Change how much health Frenzied Regeneration gives per point of rage. With
#                     0, it gives the game data's 0.3% of max health per rage again.
#        Default:     1
#

ForeverDruid.FrenziedRegeneration.Enable = 1

#
#    ForeverDruid.FrenziedRegeneration.HealthPercentPerRage
#        Description: Share of max health each point of rage becomes, in steps of 0.1. At 1.0
#                     (WoW Forever's value), the full 100 rage it can use over 10 seconds heals
#                     100% of max health. Stock is 0.3. The optional client patch must use the same
#                     value for the tooltip to match (see tools/patch-forever-druid-dbc.sh).
#        Default:     1.0
#

ForeverDruid.FrenziedRegeneration.HealthPercentPerRage = 1.0

#
#    ForeverDruid.Lacerate.ScaleWithLevel
#        Description: The module moves Lacerate (rank 1) from level 66 to 42 on the trainers, but
#                     its damage (31 on the hit and 31 per bleed tick, per stack) was set for 66.
#                     With 1, it does 20 at level 42, growing to the usual 31 at 66. With 0, it
#                     does 31 at every level. The optional client patch's tooltip assumes 1.
#        Default:     1
#

ForeverDruid.Lacerate.ScaleWithLevel = 1

#
#    ForeverDruid.Pulverize.Enable
#        Description: Druids learn Pulverize, Cataclysm's bear finisher: a melee attack that uses
#                     up the Lacerate stacks on the target for extra damage and a crit buff. With
#                     0, druids who learned it lose it at their next login.
#        Default:     1
#

ForeverDruid.Pulverize.Enable = 1

#
#    ForeverDruid.Pulverize.Level
#        Description: Level at which druids learn Pulverize. The module also moves Lacerate to
#                     level 42 on the trainers (in the database, not a setting), so both arrive
#                     together.
#        Default:     42
#

ForeverDruid.Pulverize.Level = 42

#
#    ForeverDruid.Pulverize.RageCost
#        Description: Rage cost. The optional client patch must use the same value.
#        Default:     15
#

ForeverDruid.Pulverize.RageCost = 15

#
#    ForeverDruid.Pulverize.WeaponDamagePercent
#        Description: The hit's damage as a percentage of weapon damage (in bear form, the form's
#                     own weapon damage). The optional client patch must use the same value.
#        Default:     60
#

ForeverDruid.Pulverize.WeaponDamagePercent = 60

#
#    ForeverDruid.Pulverize.AttackPowerPerStack
#        Description: Extra damage for each Lacerate stack used up, as a share of attack power.
#                     At 0.04, 5 stacks with 8000 attack power add 1600. The optional client patch
#                     must use the same value.
#        Default:     0.04
#

ForeverDruid.Pulverize.AttackPowerPerStack = 0.04

#
#    ForeverDruid.Pulverize.CritPerStack
#        Description: Melee crit chance, in percent, for each Lacerate stack used up, for 10
#                     seconds: up to 10% at 5 stacks. 0 for no buff. The optional client patch
#                     must use the same value.
#        Default:     2
#

ForeverDruid.Pulverize.CritPerStack = 2

#
#    ForeverDruid.FormSpeed.Enable
#        Description: With mod-mount-scaling installed, Travel Form, Flight Form and Swift Flight
#                     Form get the same level-scaled speed as a mount: ground speed from
#                     Apprentice or Journeyman Riding, flight speed from Expert or Artisan Riding.
#                     The numbers come from mod-mount-scaling's own MountScaling.* settings. A
#                     druid without the riding skill for it keeps the form's stock speed (Travel
#                     Form 40%, Flight Form 150%, Swift Flight Form 280%). Indoors Travel Form is
#                     always the stock 40%, and it never drops below 40%. Does nothing without
#                     mod-mount-scaling or with MountScaling.Enable = 0.
#        Default:     1
#

ForeverDruid.FormSpeed.Enable = 1

#
#    ForeverDruid.FormSpeed.OutOfCombatOnly
#        Description: With 1, Travel Form only gets the mount speed out of combat: entering
#                     combat drops it to the stock 40% and leaving combat brings it back. Mounts
#                     can't be used in combat at all. The flight forms aren't affected. With 0,
#                     Travel Form keeps the mount speed in combat too.
#        Default:     1
#

ForeverDruid.FormSpeed.OutOfCombatOnly = 1

#
#    ForeverDruid.TravelFormIndoors.Enable
#        Description: Let Travel Form be used indoors. Stock Travel Form is outdoors only: it
#                     can't be cast indoors, and walking into a building cancels it. With 1,
#                     walking inside keeps it (at the stock 40% speed). Casting it indoors also
#                     needs the optional client patch (tools/patch-forever-druid-dbc.sh); without
#                     it the client still refuses it indoors. The flight forms stay outdoors only.
#        Default:     1
#

ForeverDruid.TravelFormIndoors.Enable = 1

#
#    ForeverDruid.FormConsumables.Enable
#        Description: Let druids use the consumables the game data blocks while shapeshifted
#                     (stat scrolls, water breathing elixirs, drums, battle standards and the like)
#                     in Cat Form, Bear Form and Dire Bear Form. Food, potions, flasks, elixirs and
#                     bandages already work in every form. Other forms keep the stock rules. The
#                     client checks this itself, so it also needs the optional client patch
#                     (tools/patch-forever-druid-dbc.sh); without it the client still says you
#                     can't do that while shapeshifted.
#        Default:     1
#

ForeverDruid.FormConsumables.Enable = 1

#
#    ForeverDruid.FormGathering.Enable
#        Description: Let druids mine (and mine or salvage creature corpses) in every form. Herb
#                     Gathering and Skinning already work in every form. The client checks this
#                     itself, so it also needs the optional client patch
#                     (tools/patch-forever-druid-dbc.sh); without it the client still says you
#                     can't do that while shapeshifted.
#        Default:     1
#

ForeverDruid.FormGathering.Enable = 1

#
#    ForeverDruid.CatComboPoints.Enable
#        Description: Cat Form combo points follow the druid from target to target with the full
#                     count, like mod-forever-rogue does for rogues. With 0 they stay on one target
#                     and are lost when you attack another or the target dies. No client patch.
#        Default:     1
#

ForeverDruid.CatComboPoints.Enable = 1

#
#    ForeverDruid.CatComboPoints.KeepAfterKill
#        Description: How long, in milliseconds, combo points left on a target that died wait for
#                     your next target. 0 loses them when the target dies (switching between
#                     living targets still carries them).
#        Default:     20000
#

ForeverDruid.CatComboPoints.KeepAfterKill = 20000

#
#    ForeverDruid.CrowdPummeler.Enable
#        Description: Turn the Manual Crowd Pummeler (item 9449, Gnomeregan) into Season of
#                     Discovery's Automatic Crowd Pummeler: Haste with unlimited uses on a
#                     cooldown, and the settings below. Stats, damage and the drop are unchanged.
#                     0 = leave item 9449 exactly as the world DB has it. Applied at startup;
#                     these settings need a worldserver restart. Replaces
#                     mod-automatic-crowd-pummeler: don't run both.
#        Default:     1
#

ForeverDruid.CrowdPummeler.Enable = 1

#
#    ForeverDruid.CrowdPummeler.CooldownSeconds
#        Description: Cooldown of the Haste use effect. The effect lasts 30 seconds, so 30 or less
#                     means permanent uptime. Season of Discovery uses 3 minutes.
#        Default:     180
#

ForeverDruid.CrowdPummeler.CooldownSeconds = 180

#
#    ForeverDruid.CrowdPummeler.RestrictClasses
#        Description: 1 = only Paladins, Shamans and Druids can equip it (as in Season of
#                     Discovery). 0 = keep the DB's class list (normally every class).
#        Default:     1
#

ForeverDruid.CrowdPummeler.RestrictClasses = 1

#
#    ForeverDruid.CrowdPummeler.FeralAttackPower
#        Description: "Equip: +N Attack Power in Cat, Bear, and Dire Bear forms only." 0 = no
#                     equip bonus. The tooltip comes from the optional client patch
#                     (tools/patch-forever-druid-dbc.sh, CROWD_PUMMELER_FERAL_ATTACK_POWER); without
#                     it the tooltip says +70 and lists Moonkin, but the bonus is still N in the
#                     three forms only.
#        Default:     69
#

ForeverDruid.CrowdPummeler.FeralAttackPower = 69
